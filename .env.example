# ==============================================================================
# FairFold — Environment Configuration Template
# ==============================================================================
# HOW TO USE
#   cp .env.example .env
#   python scripts/generate_secret_key.py    # fills in the two secret keys
#   docker-compose up -d
#
# RULES
#   - This file IS committed to git. It must never contain real secrets.
#   - `.env` is gitignored. Never commit it.
#   - Every variable below is documented in the Complete Project Document, §C.7.
#   - Variables marked OPTIONAL are feature-gated; leave them commented until
#     the phase that needs them (see §9 Implementation Roadmap).
# ==============================================================================


# ------------------------------------------------------------------------------
# DJANGO CORE
# ------------------------------------------------------------------------------

# 512-bit random secret. ROTATE ON EVERY DEPLOY.
# Generate:  python scripts/generate_secret_key.py
DJANGO_SECRET_KEY=change-me-generate-a-real-key

# Which settings module to load.
#   local       — development (DEBUG on, PostgreSQL 17 + pgvector via Docker)
#   test        — pure unit tests only (in-memory SQLite). pgvector does NOT exist
#                 in SQLite, so any test touching a VectorField (matching,
#                 embeddings, screening) must use config.settings.ci instead.
#   ci          — CI pipeline (PostgreSQL + pgvector, unit and integration alike)
#   production  — production (DEBUG off, HTTPS, Sentry)
DJANGO_SETTINGS_MODULE=config.settings.local

# Django debug mode. MUST be False in production.
DEBUG=True

# Comma-separated hostnames Django will serve.
# Include 0.0.0.0 for local browser access to the bound dev server.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]

# Comma-separated origins allowed to submit CSRF-protected POSTs.
# Include the scheme, e.g. https://app.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://0.0.0.0:8000

# Django sites framework ID (used for absolute URLs in emails).
SITE_ID=1


# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL 17 + pgvector
# ------------------------------------------------------------------------------
# NOTE: docker-compose overrides DATABASE_URL using DB_PASSWORD so that
# container-to-container hostnames resolve correctly. DB_PASSWORD is therefore
# the only value here that Compose actually reads. The rest are used when
# running Django directly on the host.

DB_PASSWORD=devpassword

# Full connection string. Use the host port (5432) when running outside Docker,
# or the service name (postgres) when running inside.
DATABASE_URL=postgresql://fairfold:devpassword@localhost:5432/fairfold_dev


# ------------------------------------------------------------------------------
# REDIS + CELERY
# ------------------------------------------------------------------------------
# NOTE: as with DATABASE_URL, Compose sets the three URLs below for the
# django/celery containers. These values apply to host-based runs.

REDIS_URL=redis://localhost:6379/0

# Celery message broker (task queue).
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery task result storage. Keep this on a SEPARATE Redis DB from the broker
# so that result writes never flush the task queue.
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# AES-256-GCM (Fernet) key for field-level encryption of sensitive columns.
# Rotating this key makes existing encrypted rows unreadable — see the data
# migration strategy in the Complete Project Document, §C.8.
# Generate:  python scripts/generate_secret_key.py
ENCRYPTION_KEY=change-me-generate-a-real-key


# ------------------------------------------------------------------------------
# EMAIL — transactional messages
# ------------------------------------------------------------------------------
# SMTP or API endpoint. django-anymail resolves the backend from this.
#   Local dev (console):  console://
#   SMTP:                 smtp://user:password@smtp.example.com:587
#   Resend:               https://<api_key>@api.resend.com
EMAIL_BACKEND_URL=console://

# Sender address used in outgoing email.
DEFAULT_FROM_EMAIL=noreply@fairfold.local

# Base URL of the verification page (design.md page #11).
EMAIL_VERIFICATION_URL=http://localhost:8000/verify-email/

# Seconds before the resend button is available again (design.md X02: 0:45).
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=45

# Lifetime of a verification link, in seconds.
EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=86400

# Optional overrides (defaults live in config/settings/base.py and are fine for
# local development):
#   PASSWORD_RESET_URL      — base URL of page #10;
#                             default http://localhost:8000/reset-password/
#   PASSWORD_RESET_TIMEOUT  — reset-link lifetime in seconds; default 3600
#   SITE_URL                — origin used to make a stored notification path
#                             absolute in the email that mirrors it;
#                             default http://localhost:8000


# ------------------------------------------------------------------------------
# ERROR TRACKING
# ------------------------------------------------------------------------------
# Sentry DSN. Safe to leave empty in local development — set it in staging and
# production so failures are reported.
SENTRY_DSN=


# ------------------------------------------------------------------------------
# AI PROVIDER — OpenRouter (required for all AI features)
# ------------------------------------------------------------------------------
# OPTIONAL: only needed once you reach Phase 2 (AI Integration).
# Sign up at https://openrouter.ai and use the free-tier models.
# Without a key the app falls back to OfflineFallbackProvider, which returns
# deterministic non-AI responses — see §6.4 of the Complete Project Document.
OPENROUTER_API_KEY=


# ------------------------------------------------------------------------------
# FILE STORAGE — S3-compatible (MinIO in development)
# ------------------------------------------------------------------------------
# The Compose stack runs MinIO and Django uses it as the default storage backend
# (Arch Doc §6.1, REQ-FR-010). These values are DEVELOPMENT ONLY.
#
# MinIO no longer publishes anonymous images: `minio/minio` was removed from
# Docker Hub and `quay.io/minio/minio` answers 401 without a login. Run
# `docker login quay.io` once before the first `docker compose up`, or point
# MINIO_IMAGE at a registry this machine is already authenticated to.
#
# Pin MINIO_IMAGE to a release tag (for example
# quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z) wherever reproducibility
# matters; `latest` is the default only because a tag cannot be pulled here to
# verify it.
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_ROOT_USER=fairfold-minio
MINIO_ROOT_PASSWORD=change-me-minio-dev-password
MINIO_BUCKET=fairfold-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Comma-separated origins allowed to PUT/POST presigned uploads from a browser
# (batch 1.19). Same shape as CSRF_TRUSTED_ORIGINS; the Compose stack also hands
# this to MinIO as its own preflight allow-list.
S3_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# The variables below are what Django itself reads. Compose sets them from the
# MINIO_* values above, so they are only needed when running Django on the host,
# or when pointing at AWS S3 / Cloudflare R2 instead of the local MinIO.
# Leaving AWS_STORAGE_BUCKET_NAME unset keeps the local filesystem backend.
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_STORAGE_BUCKET_NAME=
#   AWS_S3_REGION_NAME=us-east-1
#   AWS_S3_ENDPOINT_URL=http://localhost:9000   # MinIO or another S3-compatible store
#   S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
#       The storage endpoint *as the browser reaches it* (batch 1.22). Compose
#       sets this for the django service; on a host run set it only when the
#       server and the browser resolve the store differently. Presigned upload
#       URLs are signed against this host; server-side reads keep
#       AWS_S3_ENDPOINT_URL. Leaving it unset means "same host".


# ------------------------------------------------------------------------------
# ANTIVIRUS — ClamAV (REQUIRED, not optional)
# ------------------------------------------------------------------------------
# Resume files are scanned before parsing. If ClamAV is unreachable the upload
# is REJECTED rather than passed through unscanned — the scan fails closed.
#
# These were marked OPTIONAL until 2026-10-04, which contradicted the fail-closed
# rule stated two lines below: with no host configured, every resume upload would
# have been rejected and nobody could have told whether the product was broken or
# the environment was. docker-compose and CI both provide a `clamav` service.
#
# There is deliberately NO way to switch the fail-closed behaviour off. A variable
# that turns the scanner off is a variable someone will set in production one day
# during an incident, and an unscanned upload is unrecoverable once parsed.
CLAMD_HOST=localhost
CLAMD_PORT=3310

# Seconds to wait for a scan before rejecting the upload. ClamAV's first request
# after boot is slow while it loads definitions, so this is generous on purpose.
CLAMD_TIMEOUT=30


# ------------------------------------------------------------------------------
# RESUME UPLOADS (REQ-FR-010, REQ-SEC-012)
# ------------------------------------------------------------------------------
# Maximum size of a resume, in bytes (default 10 MB). The presign endpoint
# rejects a larger declaration before any URL is issued; the completion check
# verifies the stored object against the same number.
# MAX_UPLOAD_SIZE_BYTES=10485760

# How long a presigned PUT stays valid, in seconds (default 300). The URL is a
# bearer credential for one object, so it is short-lived on purpose.
# RESUME_PRESIGN_EXPIRES_SECONDS=300


# ------------------------------------------------------------------------------
# BILLING — Stripe (OPTIONAL, Phase 5)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
