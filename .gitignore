# ==============================================================================
# FairFold
# ==============================================================================
# Ordered so the patterns a developer is most likely to add by accident come
# first. Each section states WHY a path is ignored, because "just ignore it" is
# how a `.env` or a `node_modules` ends up committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# SECRETS -- never commit
# ------------------------------------------------------------------------------
# `.env.example` IS committed; `.env` holds the real keys. The `!` line matters:
# without it, a pattern like `*.env` would take the template with it.
.env
.env.*
!.env.example

# Database dumps. A `pg_dump` of development data contains resume text and
# encrypted PII columns, and an encrypted column is only as safe as its key.
*.sql
*.dump
backups/

# ------------------------------------------------------------------------------
# PYTHON
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/

# ------------------------------------------------------------------------------
# DJANGO
# ------------------------------------------------------------------------------
# A real `.env` and a real SQLite file must never be committed. Generated
# migrations are NOT ignored: Complete Doc §C.8.1 requires them committed, and
# `makemigrations --check` in CI fails if a model change has no migration.
*.sqlite3
db.sqlite3
staticfiles/
media/

# `.coverage` and `htmlcov/` are regenerated by the CI test step. A committed
# coverage report is a stale one within a day.
.coverage
.coverage.*
coverage.xml
htmlcov/

# ------------------------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*

# The BUILT stylesheet. `static/css/tailwind.css` is generated by `npm run build`
# and committed only if the team chooses to ship a fallback; the SOURCE
# (`tailwind.src.css`) and the tokens are the files under review.
static/css/tailwind.css

# Vendored JS is copied from node_modules by a build step, not hand-committed.
static/js/htmx.min.js
static/js/chart.min.js

# ------------------------------------------------------------------------------
# TOOLS / EDITORS / OS
# ------------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.bandit/
.tox/

licence-report.csv

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ------------------------------------------------------------------------------
# DOCS -- generated, not authored
# ------------------------------------------------------------------------------
# The OpenAPI schema is a CI *artifact* (Arch Doc §6.5), not a reviewed file. A
# committed copy drifts from the code and nobody notices which one is right.
schema.yml
openapi.yaml